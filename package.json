{
  "name": "resumely",
  "version": "0.1.0",
  "private": true,
  "description": "Resume builder: upload a resume, pick a theme, edit on the page or by chat, export PDF.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
