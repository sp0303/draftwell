# Copy this file to .env and fill in the values.

PORT=3000

# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster.example.net
MONGO_URL=
MONGO_DB=resumely
# Prefix added to every collection name (resumely_users, resumely_resumes)
# so the database can be shared with other projects.
MONGO_COLLECTION_PREFIX=resumely_

# Folder where uploaded resume files are stored (created if missing)
UPLOAD_DIR=./storage/uploads

# Set to true when the site is served over HTTPS so cookies are marked Secure
COOKIE_SECURE=false

# Google sign-in: OAuth client ID (Web application) from Google Cloud Console.
# Leave empty to hide the Sign in with Google button.
GOOGLE_CLIENT_ID=

# Public address of the site (sent to OpenRouter as the referring app)
APP_URL=http://localhost:3000

# Language model via OpenRouter. Leave LLM_API_KEY empty to use the built-in
# rules for reading resumes and for chat. Several OpenRouter accounts: separate the
# keys with commas; each has its own daily free limit, counted per key.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=baidu/ernie-5.5-flash-preview:free
# Tried in order when the main model is busy (free models are often rate-limited)
LLM_FALLBACK_MODELS=particle-ai/particle-1:free,nvidia/nemotron-3.5-super-vl:free

# AI credits a new account starts with (1 credit = 1,000 AI tokens).
# At 0 credits the app keeps working on the built-in rules.
AI_STARTING_CREDITS=100
# Google accounts that can open the admin page (#admin), comma separated
ADMIN_EMAILS=

# Network interface to listen on. 127.0.0.1 in production (behind nginx).
HOST=

# Second AI provider, tried after OpenRouter: NVIDIA API catalog (build.nvidia.com).
# Leave empty to use OpenRouter only. Several keys: separate them with commas;
# requests take turns, and a rate-limited or rejected key hands over to the next.
NVIDIA_API_KEY=
NVIDIA_MODELS=minimaxai/minimax-m3.1-flash,nvidia/nemotron-3.5-lightning-30b-a3b

# OpenRouter daily cap on free models, shown on the admin page: 50, or 1000 once $10 of credit was bought.
OPENROUTER_DAILY_LIMIT=50

# One order across both providers ("provider:model", comma separated). Overrides the
# grouping above (all OpenRouter models, then NVIDIA). Providers without a key are skipped.
LLM_ORDER=openrouter:baidu/ernie-5.5-flash-preview:free,nvidia:minimaxai/minimax-m3.1-flash,openrouter:particle-ai/particle-1:free,openrouter:nvidia/nemotron-3.5-super-vl:free,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b

# Third AI provider: Google's Gemini API (aistudio.google.com). Several keys: separate with commas.
# Free limits per model family (requests a minute, tokens a minute, requests a day) are in
# src/quota.js; override or add with LLM_LIMITS, a JSON array of
# {"provider":"gemini","family":"3.6 Flash","models":["gemini-3.6-flash"],"rpm":5,"tpm":250000,"rpd":20}.
GEMINI_API_KEY=
# "paid" once billing is on for the key's Google Cloud project: drops the free-tier limits
# for Gemini models and keeps only a daily spending guard per model family.
GEMINI_TIER=
GEMINI_DAILY_LIMIT=1500
GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
# LLM_ORDER with tiers: commas between tiers, "|" between models of one tier. Within a tier,
# the model with the most free room left today goes first.
# LLM_ORDER=gemini:gemini-3.6-flash|gemini:gemini-3-flash-preview|openrouter:baidu/ernie-5.5-flash-preview:free,gemini:gemini-3.1-flash-lite|gemini:gemini-3.5-flash-lite|nvidia:minimaxai/minimax-m3.1-flash|openrouter:particle-ai/particle-1:free,gemini:gemma-4-31b-it|gemini:gemma-4-26b-a4b-it|openrouter:nvidia/nemotron-3.5-super-vl:free|nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
# Paid Gemini first (3.5 Flash Lite: cheapest model that tailors without inventing), free providers as backups:
# LLM_ORDER=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite|gemini:gemini-3.5-flash|nvidia:minimaxai/minimax-m3.1-flash|openrouter:baidu/ernie-5.5-flash-preview:free,openrouter:particle-ai/particle-1:free|openrouter:nvidia/nemotron-3.5-super-vl:free|nvidia:nvidia/nemotron-3.5-lightning-30b-a3b|gemini:gemma-4-26b-a4b-it
