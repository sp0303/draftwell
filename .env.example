# Copy this file to .env and fill in the values.

PORT=3000

# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster.example.net
MONGO_URL=
MONGO_DB=resumely
# Prefix added to every collection name (resumely_users, resumely_resumes)
# so the database can be shared with other projects.
MONGO_COLLECTION_PREFIX=resumely_

# Folder where uploaded resume files are stored (created if missing)
UPLOAD_DIR=./storage/uploads

# Set to true when the site is served over HTTPS so cookies are marked Secure
COOKIE_SECURE=false

# Google sign-in: OAuth client ID (Web application) from Google Cloud Console.
# Leave empty to hide the Sign in with Google button.
GOOGLE_CLIENT_ID=

# Public address of the site (sent to OpenRouter as the referring app)
APP_URL=http://localhost:3000

# Language model via OpenRouter. Leave LLM_API_KEY empty to use the built-in
# rules for reading resumes and for chat.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
# Tried in order when the main model is busy (free models are often rate-limited)
LLM_FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free

# AI credits a new account starts with (1 credit = 1,000 AI tokens).
# At 0 credits the app keeps working on the built-in rules.
AI_STARTING_CREDITS=100
# Google accounts that can open the admin page (#admin), comma separated
ADMIN_EMAILS=

# Network interface to listen on. 127.0.0.1 in production (behind nginx).
HOST=

# Second AI provider, tried after OpenRouter: NVIDIA API catalog (build.nvidia.com).
# Leave empty to use OpenRouter only.
NVIDIA_API_KEY=
NVIDIA_MODELS=minimaxai/minimax-m3.1-flash,nvidia/nemotron-3.5-lightning-30b-a3b
