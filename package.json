    "express": "^4.22.3",
    "google-auth-library": "^9.15.1",
    "mammoth": "^1.13.0",
    "mongodb": "^6.22.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.65.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
